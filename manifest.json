{
    "manifest_version": 3,
    "name": "Bookmark Cleaner",
    "version": "0.2.0",
    "description": "Find and remove duplicate bookmarks. Smart URL matching, always keeps one copy, one-click undo. Private: no tracking.",
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "author": "Ruggero Turra",
    "minimum_chrome_version": "104",
    "permissions": [
        "bookmarks",
        "favicon"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Bookmark Cleaner",
        "default_icon": "icon128.png"
    },
    "options_page": "main.html",
    "offline_enabled": true,
    "content_security_policy": {
        "extension_pages": "script-src 'self' ; object-src 'self'"
    }
}
